generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  properties Property[]

  @@map("users")
}

model Property {
  id         String   @id @default(uuid())
  name       String
  city       String
  state      String
  areaHa     Float
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id])
  plots      Plot[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("properties")
}

model Plot {
  id         String   @id @default(uuid())
  name       String
  areaHa     Float
  soilType   String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  crops      Crop[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("plots")
}

model Crop {
  id                 String            @id @default(uuid())
  name               String
  variety            String?
  plantedAt          DateTime
  expectedHarvestAt  DateTime?
  plotId             String
  plot               Plot              @relation(fields: [plotId], references: [id])
  inputApplications  InputApplication[]
  harvests           Harvest[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@map("crops")
}

model InputApplication {
  id          String   @id @default(uuid())
  productName String
  quantity    Float
  unit        String
  appliedAt   DateTime
  cropId      String
  crop        Crop     @relation(fields: [cropId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("input_applications")
}

model Harvest {
  id          String   @id @default(uuid())
  quantityKg  Float
  harvestedAt DateTime
  cropId      String
  crop        Crop     @relation(fields: [cropId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("harvests")
}
